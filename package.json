{
  "name": "morphinpedia-mono",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "metro": "^0.82.1",
    "metro-resolver": "^0.82.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.21",
    "eslint": "^8.21.0",
    "turbo": "^2.4.4",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "postinstall": "bunx patch-package",
    "native": "cd apps/expo && bun start",
    "web": "cd apps/next && bun next",
    "postinstall:css": "npx tailwindcss -i ./apps/expo/global.css -o ./node_modules/.cache/nativewind/global.css"
  },
  "packageManager": "yarn@4.7.0",
  "eslintConfig": {
    "extends": "next",
    "settings": {
      "next": {
        "rootDir": "apps/next/"
      }
    },
    "root": true
  },
  "prettier": {
    "semi": false,
    "useTabs": false,
    "tabWidth": 2,
    "singleQuote": true
  }
}
